# PostgreSQL connection for Prisma.
# Example: postgresql://postgres:postgres@localhost:5432/prices?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Login for the single built-in admin account.
APP_LOGIN=admin

# Bcrypt hash for the admin password.
# Generate locally:
# node -e "require('bcrypt').hash('change-me', 10).then(console.log)"
APP_PASSWORD_HASH="$2b$10$replace-with-bcrypt-hash"

# Long random string for signing the session cookie.
# Generate locally:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=replace-with-long-random-string

# true for HTTPS production, false for local HTTP development.
APP_COOKIE_SECURE=false

# Optional AI helper config.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional Polza AI config.
POLZA_AI_API_KEY=
POLZA_AI_MODEL=google/gemini-3.1-flash-lite
POLZA_AI_BASE_URL=https://polza.ai/api/v1

# Optional iiko Server API config.
IIKO_SERVER_URL=https://laybrari-bar.iiko.it
IIKO_API_USERNAME=gubarevweb
IIKO_API_PASSWORD=
IIKO_API_TIMEOUT_MS=15000
